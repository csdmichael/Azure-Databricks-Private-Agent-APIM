<!-- GET /genie/conversations/{conversationId}/messages/{messageId}/result : fetch the SQL result Genie generated. -->
<policies>
  <inbound>
    <base />
    <rewrite-uri template="/api/2.0/genie/spaces/{{databricks-genie-space-id}}/conversations/{conversationId}/messages/{messageId}/query-result" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
