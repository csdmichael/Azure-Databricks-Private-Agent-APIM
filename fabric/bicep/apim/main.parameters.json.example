{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceApiClientId": {
      "value": "REPLACE-WITH-RESOURCE-API-CLIENT-ID"
    },
    "connectorClientIds": {
      "value": [
        "REPLACE-WITH-LAKEHOUSE-CONNECTOR-CLIENT-ID",
        "REPLACE-WITH-DATA-AGENT-CONNECTOR-CLIENT-ID"
      ]
    },
    "allowedFabricGuestObjectIds": {
      "value": [
        "REPLACE-WITH-FABRIC-GUEST-OBJECT-ID"
      ]
    },
    "brokerAudience": {
      "value": "REPLACE-WITH-BROKER-API-CLIENT-ID"
    },
    "brokerPrivateUrl": {
      "value": "https://fabric-parts-obo-broker-my.azurewebsites.net"
    },
    "brokerPrivateEndpointIp": {
      "value": "REPLACE-WITH-IP"
    },
    "applicationInsightsName": {
      "value": ""
    },
    "applicationInsightsResourceGroupName": {
      "value": ""
    },
    "createPrivateDnsZone": {
      "value": true
    },
    "privateDnsZoneResourceGroupName": {
      "value": ""
    }
  }
}