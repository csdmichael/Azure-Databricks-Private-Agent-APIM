<policies>
  <inbound>
    <base />
    <rate-limit calls="30" renewal-period="60" />
    <authentication-managed-identity resource="2ff814a6-3304-4ab8-85cb-cd0e6f879c1d" output-token-variable-name="databricks-access-token" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["databricks-access-token"])</value>
    </set-header>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
