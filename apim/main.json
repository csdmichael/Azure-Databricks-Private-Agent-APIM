  "variables": {
    "$fxv#0": "<!--\r\n  API-level policy for the Databricks API.\r\n  - Uses APIM's system-assigned managed identity to obtain an Entra token for the\r\n    Databricks login application, then forwards it as the backend Authorization.\r\n    (The APIM MI must be added as a user in the Databricks workspace with access\r\n    to the SQL warehouse and configured Unity Catalog schema.)\r\n  - Routes all operations to the private workspace control-plane URL.\r\n  - Applies a conservative rate limit for the POC.\r\n-->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rate-limit calls=\"{{databricks-rate-limit-calls}}\" renewal-period=\"{{databricks-rate-limit-renewal-period}}\" />\r\n    <authentication-managed-identity resource=\"2ff814a6-3304-4ab8-85cb-cd0e6f879c1d\"\r\n                                     output-token-variable-name=\"msi-access-token\" ignore-error=\"false\" />\r\n    <set-header name=\"Authorization\" exists-action=\"override\">\r\n      <value>@(\"Bearer \" + (string)context.Variables[\"msi-access-token\"])</value>\r\n    </set-header>\r\n    <set-backend-service base-url=\"{{databricks-workspace-url}}\" />\r\n  </inbound>\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n",
    "$fxv#1": "<!--\r\n  POST /query  ->  Databricks SQL Statement Execution API.\r\n  Consumers send only { \"statement\": \"SELECT ...\" }.\r\n  The warehouse id and execution options are injected server-side so the\r\n  warehouse stays an internal detail of the gateway.\r\n-->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rewrite-uri template=\"/api/2.0/sql/statements\" />\r\n    <set-body>@{\r\n      var body = context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);\r\n      body[\"warehouse_id\"] = \"{{databricks-warehouse-id}}\";\r\n      if (body[\"wait_timeout\"] == null) { body[\"wait_timeout\"] = \"{{databricks-sql-wait-timeout}}\"; }\r\n      body[\"on_wait_timeout\"] = \"CONTINUE\";\r\n      body[\"format\"] = \"JSON_ARRAY\";\r\n      body[\"disposition\"] = \"INLINE\";\r\n      return body.ToString();\r\n    }</set-body>\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n",
    "$fxv#2": "<!--\r\n  GET /tables  ->  lists the sample tables in the configured catalog and schema.\r\n  A fixed, safe read-only statement so agents can discover the schema.\r\n-->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rewrite-uri template=\"/api/2.0/sql/statements\" />\r\n    <set-method>POST</set-method>\r\n    <set-body>@{\r\n      var body = new Newtonsoft.Json.Linq.JObject();\r\n      body[\"warehouse_id\"] = \"{{databricks-warehouse-id}}\";\r\n      body[\"statement\"] = \"SHOW TABLES IN {{databricks-catalog}}.{{databricks-schema}}\";\r\n      body[\"wait_timeout\"] = \"{{databricks-sql-wait-timeout}}\";\r\n      body[\"on_wait_timeout\"] = \"CONTINUE\";\r\n      body[\"format\"] = \"JSON_ARRAY\";\r\n      body[\"disposition\"] = \"INLINE\";\r\n      return body.ToString();\r\n    }</set-body>\r\n    <set-header name=\"Content-Type\" exists-action=\"override\">\r\n      <value>application/json</value>\r\n    </set-header>\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n",
    "$fxv#3": "<!--\r\n  API-level policy for the Databricks Genie (AI/BI) API.\r\n  Same managed-identity auth + private backend routing as the Databricks API.\r\n-->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rate-limit calls=\"{{genie-rate-limit-calls}}\" renewal-period=\"{{genie-rate-limit-renewal-period}}\" />\r\n    <authentication-managed-identity resource=\"2ff814a6-3304-4ab8-85cb-cd0e6f879c1d\"\r\n                                     output-token-variable-name=\"msi-access-token\" ignore-error=\"false\" />\r\n    <set-header name=\"Authorization\" exists-action=\"override\">\r\n      <value>@(\"Bearer \" + (string)context.Variables[\"msi-access-token\"])</value>\r\n    </set-header>\r\n    <set-backend-service base-url=\"{{databricks-workspace-url}}\" />\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n",
    "$fxv#4": "<!-- POST /genie/ask : start a Genie conversation on the configured space. Body: { \"content\": \"natural-language question\" } -->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rewrite-uri template=\"/api/2.0/genie/spaces/{{databricks-genie-space-id}}/start-conversation\" />\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n",
    "$fxv#5": "<!-- POST /genie/conversations/{conversationId}/messages : ask a follow-up. Body: { \"content\": \"...\" } -->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rewrite-uri template=\"/api/2.0/genie/spaces/{{databricks-genie-space-id}}/conversations/{conversationId}/messages\" />\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n",
    "$fxv#6": "<!-- GET /genie/conversations/{conversationId}/messages/{messageId}/result : fetch the SQL result Genie generated. -->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rewrite-uri template=\"/api/2.0/genie/spaces/{{databricks-genie-space-id}}/conversations/{conversationId}/messages/{messageId}/query-result\" />\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n",
    "$fxv#7": "<!-- GET /genie/conversations/{conversationId}/messages/{messageId} : poll message status and read the text/query attachments. -->\r\n<policies>\r\n  <inbound>\r\n    <base />\r\n    <rewrite-uri template=\"/api/2.0/genie/spaces/{{databricks-genie-space-id}}/conversations/{conversationId}/messages/{messageId}\" />\r\n  </inbound>\r\n  <backend><base /></backend>\r\n  <outbound><base /></outbound>\r\n  <on-error><base /></on-error>\r\n</policies>\r\n"
  },
