          "id": "visits",
          "partitionKey": {
            "paths": [
              "/day"
            ],
            "kind": "Hash",
            "version": 2
          },
          "defaultTtl": 7776000,
          "indexingPolicy": {
            "automatic": true,
            "indexingMode": "consistent",
            "includedPaths": [
              {
                "path": "/day/?"
              }
            ],
            "excludedPaths": [
              {
                "path": "/*"
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', parameters('cosmosName'), 'showcase-analytics')]"
      ]
    },
