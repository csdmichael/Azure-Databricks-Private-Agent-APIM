{
  "version": "2.0",
  "functionTimeout": "00:01:00",
  "logging": {
    "logLevel": { "default": "Warning", "Host.Results": "Information", "Function.exchange.User": "Information" },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": false },
      "enableDependencyTracking": false,
      "enableLiveMetricsFilters": true,
      "httpAutoCollectionOptions": { "enableHttpTriggerExtendedInfoCollection": false }
    }
  },
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" }
}